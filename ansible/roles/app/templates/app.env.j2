# {{ ansible_managed }} (role: app)
APP_ENV={{ app_env }}
AWS_REGION={{ app_aws_region }}
AWS_DEFAULT_REGION={{ app_aws_region }}
PORT={{ app_port }}
WEB_CONCURRENCY={{ app_web_concurrency }}
DB_HOST={{ app_db_host }}
DB_PORT={{ app_db_port }}
DB_NAME={{ app_db_name }}
# Credentials are fetched at runtime from this RDS-managed secret; no password on disk.
DB_SECRET_ARN={{ app_db_secret_arn }}
DB_SSLMODE=require
